    "WIDGET-ATTENDANCE-REQUIRED" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere in der App ein Meeting mit „Ich nehme teil“, um diese Option zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημείωσε μια συγκέντρωση με «Συμμετέχω» στην εφαρμογή για να ενεργοποιήσεις αυτή την επιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark a meeting “I attend” in the app to enable this option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca una reunión con «Asisto» en la app para activar esta opción."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca una reunión con «Asisto» en la app para activar esta opción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coche « Je participe » pour une réunion dans l’app afin d’activer cette option."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona «Partecipo» per una riunione nell’app per attivare questa opzione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque uma reunião com “Participo” no app para ativar esta opção."
          }
        }
      }
    },
    "WIDGET-DESCRIPTION" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein nächstes vorgemerktes Meeting, laufende und bevorstehende Meetings."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επόμενη συγκέντρωση στην οποία συμμετέχεις, οι συγκεντρώσεις σε εξέλιξη και οι προσεχείς συγκεντρώσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your next attended meeting, meetings in progress, and upcoming meetings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu próxima reunión marcada, las reuniones en curso y las próximas reuniones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu próxima reunión marcada, las reuniones en curso y las próximas reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta prochaine réunion marquée, les réunions en cours et les prochaines réunions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prossima riunione che frequenti, le riunioni in corso e quelle in programma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua próxima reunião marcada, reuniões em andamento e próximas reuniões."
          }
        }
      }
    },
