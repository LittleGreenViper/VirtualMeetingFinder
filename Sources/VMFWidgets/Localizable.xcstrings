    "WIDGET-DESCRIPTION": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next attended meeting, meetings in progress, and upcoming meetings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein nächstes vorgemerktes Meeting, laufende und bevorstehende Meetings."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επόμενη συνάντηση που παρακολουθείς, οι συναντήσεις σε εξέλιξη και οι προσεχείς συναντήσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próxima reunión marcada, las reuniones en curso y las próximas reuniones."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próxima reunión marcada, las reuniones en curso y las próximas reuniones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prochaine réunion marquée, les réunions en cours et les prochaines réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima riunione che frequenti, le riunioni in corso e quelle in programma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua próxima reunião marcada, reuniões em andamento e próximas reuniões."
          }
        }
      }
    },
